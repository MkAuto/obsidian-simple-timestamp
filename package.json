{
	"name": "obsidian-simple-timestamp",
	"version": "1.1.0",
	"description": "Automatically writes the current date and time to a frontmatter property whenever you edit a note.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"obsidian": "1.14.4",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0"
	},
	"overrides": {
		"moment": "2.31.0"
	}
}
